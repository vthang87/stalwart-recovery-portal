APP_NAME=Stalwart Recovery Portal
APP_URL=https://mail.domain.com
BASE_PATH=/account
PORT=3000
DATA_DIR=/data
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

STALWART_URL=http://stalwart:8080
STALWART_API_TOKEN=CHANGE_ME
STALWART_OAUTH_CLIENT_ID=stalwart-recovery-portal

RECOVERY_ADMIN_PERMISSIONS=sysAccountQuery

OTP_LENGTH=6
PASSWORD_MIN_LENGTH=8
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=stalwart
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=noreply@domain.com
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM_NAME=Mail Recovery
MAIL_FROM_ADDRESS=noreply@domain.com

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
